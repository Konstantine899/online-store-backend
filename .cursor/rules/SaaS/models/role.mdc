export const ADMIN_ROLES = [...SYSTEM_ADMIN_ROLES, ...TENANT_ADMIN_ROLES];
export const ALL_ROLES = [...SYSTEM_ROLES, ...STAFF_ROLES, ...CUSTOMER_ROLES, ...GUEST_ROLES];

