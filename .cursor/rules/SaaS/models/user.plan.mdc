          note: |
          ⚠️ КРИТИЧНО: escapeLikeWildcards НЕ СУЩЕСТВУЕТ в кодебазе!
          Нужно СОЗДАТЬ перед написанием тестов.
          Функция должна экранировать спец. символы SQL LIKE: %, \_, \

            Пример реализации:
            export function escapeLikeWildcards(str: string): string {
            return str.replace(/\\/g, '\\\\')
            .replace(/%/g, '\\%')
            .replace(/_/g, '\\_');
            }

