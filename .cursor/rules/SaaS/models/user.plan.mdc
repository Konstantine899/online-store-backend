# User Module Execution Plan (Binding)

binding: true
module: user
epic_ref: USER-001
version: 1.0

execution_policy:
must_follow: true
allow_code_changes_only_after: "Одобряю <TASK_ID>"
constraints: - no public API changes without explicit approval - operate strictly within files_scope - pass lints/tests and Swagger before DoD complete

context:
goal: User system enhancement with atomic approach - profile fields, consent flags, addresses, preferences

# DEFAULT PRE-COMMIT WORKFLOW для всех user задач

default_pre_commit_workflow: "СТАНДАРТНЫЙ (business logic: user management)"
default_pre_commit_steps:

- "«Ревью» → business logic, user data handling, validation"
- "«Автофикс» → linter/prettier"
- "Тесты: user integration tests"
- "«Коммит» → feat(user): <TASK_ID> complete"

tasks:

# Фаза 1: Базовый профиль пользователя

- id: USER-001-01
  title: Добавить поля имени и фамилии в профиль пользователя
  branch: "feature/user/USER-001/add-name-fields"
  files_scope:
    - "db/migrations/**"
    - "db/models/user.ts"
    - "db/models/types.ts"
    - "src/domain/models/user.model.ts"
    - "src/infrastructure/services/user/**"
    - "src/infrastructure/dto/user/**"
    - "src/infrastructure/controllers/user/**"
  steps:
    - создать миграцию для добавления колонок first_name, last_name в таблицу users
    - обновить db/models/types.ts и db/models/user.ts с новыми полями
    - обновить UserModel (Domain) с новыми полями и валидацией (@IsValidName)
    - добавить методы для работы с именем/фамилией в UserService
    - создать UpdateUserProfileDto с валидацией имени (@IsValidName)
    - добавить endpoint PATCH /users/profile для обновления профиля
    - написать unit тесты для сервиса
    - написать integration тесты для API endpoint
    - обновить Swagger документацию
  dod:
    - миграция up/down успешна
    - UserModel содержит first_name и last_name с валидацией
    - API endpoint PATCH /users/profile работает с валидацией
    - тесты покрывают новую функциональность
    - Swagger документация обновлена
  pre_commit_workflow: "ОБЫЧНЫЙ"
  pre_commit_steps:
    - "«Ревью» → validation logic, name sanitization"
    - "«Автофикс» → linter/prettier"
    - "Тесты: unit + integration tests"
    - "«Коммит» → feat(user): add firstName and lastName fields to user profile"
  gate:
    - require: "Одобряю USER-001-01"

