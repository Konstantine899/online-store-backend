- id: SAAS-017-01
  title: Создать миграции для таблиц roles, user_roles, role_permissions
  status: COMPLETED
  completed_at: "2024-11-21"
  branch: "feature/role/SAAS-017/role-core-tables"
  commits:
    - hash: "4c8ccf3"
      message: "feat(role): SAAS-017-01 - create migrations and models for role system"
      actual_hours: ~4
      files_scope:
    - "db/migrations/\*\*"
    - "src/domain/models/role.model.ts"
    - "src/domain/models/user-role.model.ts"
    - "src/domain/models/role-permission.model.ts"
      architectural_decisions:
      table_naming:
      decision: "Переименовать role → roles, user_role → user_roles"
      rationale: "Соответствие спецификации и соглашению (множественное число)"
      action: "Удалить старые таблицы, создать новые"
      tenant_id_nullability:
      decision: "tenant_id INTEGER NULL без CHECK constraint"
      rationale: "Системные роли (SUPER_ADMIN) работают вне контекста тенанта"
      constraint_status: "CHECK constraint НЕ реализован из-за ограничения MySQL (FK + CHECK несовместимы). Валидация переносится на уровень приложения (DTO/модели)"
      unique_constraint:
      decision: "UNIQUE(user_id, role_id, tenant_id)"
      rationale: "Один пользователь может иметь одну роль в разных тенантах"
      migration_order:
      sequence: ["roles", "user_roles", "role_permissions"]
      rationale: "Соблюдение порядка из-за FK зависимостей"
      json_type:
      decision: "Использовать JSON вместо JSONB"
      rationale: "MySQL не поддерживает JSONB (это PostgreSQL тип)"
      deliverables:
